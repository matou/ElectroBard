            "title": "Content Type"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration Seconds"
          },
          "error_detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Detail"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_errored": {
            "title": "Is Errored",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/SoundKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "youtube_video_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
