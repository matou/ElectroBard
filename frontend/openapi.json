            "title": "Id",
            "type": "string"
          },
          "is_errored": {
            "title": "Is Errored",
            "type": "boolean"
          },
          "kind": {
            "$ref": "#/components/schemas/SoundKind"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
