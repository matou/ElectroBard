          "name",
          "kind",
          "duration_seconds",
          "is_errored",
          "error_detail",
          "youtube_video_id",
          "content_type",
          "created_at"
        ],
        "title": "YoutubeSoundRead",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "ElectroBard API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/sounds": {
      "get": {
        "description": "List the current user's sounds, A-Z by name.\n\n`?tag=` filters to sounds carrying that tag id; `?q=` is an optional\ncase-insensitive substring search on `name`. Both are scoped to the current user.",
        "operationId": "list_sounds",
        "parameters": [
          {
            "in": "query",
            "name": "tag",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Tag"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SoundRead"
                  },
                  "title": "Response List Sounds",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Sounds",
        "tags": [
          "sounds"
        ]
      }
    },
    "/api/sounds/upload": {
      "post": {
        "description": "Multipart upload -> one `file` Sound (api-contract \"Upload ingestion\", #22).\n\nFormat is validated by the filename's extension against a fixed allowlist \u2014 the\nclient's declared Content-Type is never trusted. The upload is buffered fully\n(no streaming, Q6) and handed to the bytes-only storage seam. The Sound row is\ncreated and flushed first to mint its UUID (so `storage_key` can embed it), and\nthe whole handler runs in `get_db`'s single request transaction: if `storage.save`\nraises, the exception propagates and that transaction rolls back, leaving no\norphan row.",
        "operationId": "upload_sound",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_sound"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoundRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload Sound",
        "tags": [
          "sounds"
        ]
      }
    },
    "/api/sounds/youtube": {
      "post": {
        "description": "`{ url }` -> one `youtube` Sound, keyless (ADR-0005, api-contract \"Sounds\").\n\nThe video ID is extracted by structural URL parse (no API key); metadata comes\nfrom YouTube's own oEmbed endpoint, which carries a title but never a duration \u2014\n`duration_seconds` stays null (client `getDuration()` backfill is post-M1).\nAdd-time embeddability is a *heuristic* on the oEmbed status, not the final\nverdict (that's the client IFrame `onError` at playback, M3/#25): 200 accepts,\n401 still accepts but flags `embed_warning`, and 400/404 reject as unusable.",
        "operationId": "add_youtube_sound",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/YoutubeAddRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/YoutubeSoundRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Add Youtube Sound",
        "tags": [
          "sounds"
        ]
      }
    },
    "/api/sounds/{sound_id}": {
      "get": {
        "description": "Fetch one sound. 404 if missing or owned by another user.",
        "operationId": "get_sound",
        "parameters": [
          {
            "in": "path",
            "name": "sound_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Sound Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SoundRead"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Sound",
        "tags": [
          "sounds"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Liveness: the process is up and serving.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/health/db": {
      "get": {
        "description": "Readiness: the database is reachable.",
        "operationId": "health_db",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Db",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Db"
      }
    }
  }
}
