{
  "components": {
    "schemas": {
      "Body_upload_sound": {
        "properties": {
          "file": {
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "type": "string"
          }
        },
        "required": [
          "file"
        ],
        "title": "Body_upload_sound",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "SoundKind": {
        "description": "The audio-source discriminator. Stored as checked text, not a native enum.",
        "enum": [
          "file",
          "youtube"
        ],
        "title": "SoundKind",
        "type": "string"
      },
